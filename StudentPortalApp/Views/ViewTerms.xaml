<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StudentPortalApp.Views.TermsPage"
             Title="Terms Page">

    <ContentPage.ToolbarItems>
        <ToolbarItem 
            x:Name="AddTerm"
            Text="Add Term"
            Clicked="AddTerm_Clicked"/>
        <ToolbarItem 
            x:Name="ClearDb"
            Text="Clear Database"
            Clicked="ClearDb_Clicked"/>
        <ToolbarItem
            x:Name="LoadDb"
            Text="Load database"
            Clicked="LoadDb_Clicked" />
    </ContentPage.ToolbarItems>
    <VerticalStackLayout>
        <Label 
            Text="My terms"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
    </VerticalStackLayout>
</ContentPage>