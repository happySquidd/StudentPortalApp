<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StudentPortalApp.Views.TermsPage"
             Title="My terms">

    <ScrollView>

        <VerticalStackLayout Padding="15"
                            Spacing="15">

            <CollectionView ItemsSource="{Binding Terms}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Border BackgroundColor="LightSteelBlue"
                            Padding="15"
                            Margin="0,0,0,10"
                            Stroke="Black"
                            StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="6" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="5">
                                <Grid ColumnDefinitions="*, *, *"
                                      VerticalOptions="Center">
                                    <Label Text="{Binding Name}"
                                           Grid.Column="0"
                                           VerticalOptions="Center"
                                           FontSize="20"
                                           FontAttributes="Bold" />
                                    <Button Text="Edit term"
                                            Grid.Column="2"
                                            VerticalOptions="Center"
                                            HorizontalOptions="Fill"
                                            MinimumHeightRequest="-1"
                                            HeightRequest="35"
                                            Padding="10,0"
                                            BackgroundColor="DodgerBlue"
                                            Clicked="EditTerm"/>
                                </Grid>
                                <Grid VerticalOptions="Center"
                                    ColumnDefinitions="0.7*, 0.3*">
                                    <Label Grid.Column="0"
                                           Text="Start date for the term"
                                           VerticalOptions="Center"
                                           HorizontalOptions="Start" />

                                    <Label Grid.Column="1" 
                                           Text="{Binding StartTime}"/>
                                </Grid>
                                <Grid ColumnDefinitions="0.7*, 0.3*"
                                      VerticalOptions="Center"
                                      Margin="0,0,0,20">
                                    <Label Grid.Column="0"
                                           Text="End date for the term"
                                           VerticalOptions="Center"
                                           HorizontalOptions="Start" />
                                    <Label Grid.Column="1" 
                                                Text="{Binding EndTime}"/>
                                </Grid>
                                <Button Text="View courses" Clicked="ViewTerm"/>
                            </VerticalStackLayout>
                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>


            </CollectionView>

            <Button Text="Add Term" Clicked="AddTerm"/>

        </VerticalStackLayout>

    </ScrollView>
</ContentPage>