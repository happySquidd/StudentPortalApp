<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StudentPortalApp.Views.EditTerm"
             Title="Term details">
    <VerticalStackLayout VerticalOptions="Center"
                         HorizontalOptions="Center">
        <Border x:Name="AddTermPopup"
                Stroke="Black"
                StrokeThickness="1"
                BackgroundColor="LightSteelBlue"
                Padding="15"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                WidthRequest="350">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="6" />
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="15">
                <Label Text="Edit term" 
                       FontAttributes="Bold" 
                       FontSize="20"/>
                <Grid ColumnDefinitions=".30*,.70*"
                      RowDefinitions="*,*,*">
                    <Label Grid.Column="0"
                           Grid.Row="0"
                           Text="Term name:"
                           VerticalOptions="Center"/>
                    <Entry Grid.Column="1"
                           Grid.Row="0"
                           x:Name="TermName" 
                           Placeholder="Term name" 
                           PlaceholderColor="BlueViolet"/>
                    <Label Grid.Column="0"
                           Grid.Row="1"
                           Text="Start Date:"
                           VerticalOptions="Center"/>
                    <DatePicker Grid.Column="1"
                                Grid.Row="1"
                                x:Name="TermStart"/>
                    <Label Grid.Column="0"
                           Grid.Row="2"
                           Text="End Date:"
                           VerticalOptions="Center"/>
                    <DatePicker Grid.Column="1" 
                                Grid.Row="2" 
                                x:Name="TermEnd"/>
                </Grid>

                <Grid ColumnDefinitions="*,*,*"
                      VerticalOptions="Center"
                      HorizontalOptions="Fill"
                      ColumnSpacing="5">
                    <Button Grid.Column="0"
                            Text="Confirm" 
                            Clicked="ConfirmEdit"/>
                    <Button Grid.Column="1" 
                            Text="Cancel" 
                            Clicked="Close"/>
                    <Button Grid.Column="2" 
                            Text="Delete Term" 
                            Clicked="DeleteTerm"
                            BackgroundColor="DarkRed"/>

                </Grid>
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
</ContentPage>