<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StudentPortalApp.Views.ViewCourse"
             Title="View course">
    <ScrollView>

        <VerticalStackLayout Padding="20"
                             Spacing="20">
            <Border Stroke="Black"
                    StrokeThickness="1"
                    BackgroundColor="LightSteelBlue"
                    Padding="15"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    WidthRequest="350">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="6" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="10">
                    <Label Text="Course view"
                           FontSize="20"
                           FontAttributes="Bold"/>

                    <Grid ColumnDefinitions=".40*,.60*"
                          RowDefinitions="*,*,*,*,*,*,*,*,*"
                          RowSpacing="13">
                        <Label Grid.Column="0"
                               Grid.Row="0"
                               Text="Course title:"
                               VerticalOptions="Center"/>
                        <Label Grid.Column="1"
                                Grid.Row="0"
                                Text="{Binding Name}"/>
                        <Label Grid.Column="0"
                               Grid.Row="1"
                               Text="Start Date:"
                               VerticalOptions="Center"/>
                        <Label Grid.Column="1"
                               Grid.Row="1"
                               Text="{Binding StartTime, StringFormat='{0:d}'}"/>
                        <Label Grid.Column="0"
                               Grid.Row="2"
                               Text="End Date:"
                               VerticalOptions="Center"/>
                        <Label Grid.Column="1" 
                               Grid.Row="2" 
                               Text="{Binding EndTime, StringFormat='{0:d}'}"/>
                        <Label Grid.Column="0"
                               Grid.Row="3"
                               Text="Status:"
                               VerticalOptions="Center"/>
                        <Label Grid.Column="1"
                               Grid.Row="3"
                               Text="{Binding Status}"/>
                        <Label Grid.Column="0"
                               Grid.Row="4"
                               Text="Instructor name:"
                               VerticalOptions="Center"/>
                        <Label Grid.Column="1"
                               Grid.Row="4"
                               Text="{Binding InstructorName}"/>
                        <Label Grid.Column="0"
                               Grid.Row="5"
                               Text="Instructor's phone:"
                               VerticalOptions="Center"/>
                        <Label Grid.Column="1"
                               Grid.Row="5"
                               Text="{Binding InstructorPhone}"/>
                        <Label Grid.Column="0"
                               Grid.Row="6"
                               Text="Instructor's email:"
                               VerticalOptions="Center"/>
                        <Label Grid.Column="1"
                               Grid.Row="6"
                               Text="{Binding InstructorEmail}"/>
                        <Label Grid.Column="0"
                               Grid.Row="7"
                               Text="Notes:"
                               VerticalOptions="Center"/>
                        <Label Grid.Column="1"
                               Grid.Row="7"
                               Text="{Binding Notes}"/>
                        <Button Grid.Column="1"
                                Grid.Row="8"
                                Text="Share notes"
                                FontSize="12"
                                Padding="0"
                                BackgroundColor="LightSlateGray"
                                Clicked="ShareCourse"
                                WidthRequest="80"
                                MinimumHeightRequest="-1"
                                HeightRequest="30"
                                HorizontalOptions="Start"/>
                    </Grid>
                    <Label VerticalOptions="End"
                           HorizontalOptions="Start"
                           x:Name="Notifications"/>
                    <Grid ColumnDefinitions=".4*,.6*">
                        
                        <Label Grid.Column="0" 
                               VerticalOptions="Center"
                               HorizontalOptions="Start"
                               Text="Due Date:"/>
                        <Label Grid.Column="1"
                           Text="{Binding DueDate, StringFormat='{0:d}'}"/>
                    </Grid>

                </VerticalStackLayout>

            </Border>

            
            <Label Text="Assessments"
                   FontSize="20"
                   FontAttributes="Bold"/>
            <Label x:Name="NoAssessmentsLabel"
                   IsVisible="False"/>

            <Border Stroke="Black"
                    StrokeThickness="1"
                    BackgroundColor="LightSteelBlue"
                    Padding="15"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    WidthRequest="350"
                    IsVisible="False"
                    x:Name="OAssessmentBorder">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="6" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="*,*"
                      RowDefinitions="*,*,*"
                      RowSpacing="10">

                    <Label Grid.Column="0" 
                           Grid.Row="0"
                           x:Name="OAName"
                           VerticalOptions="Center"
                           FontSize="16"/>
                    <Border Grid.Column="1"
                            Grid.Row="0"
                            BackgroundColor="PaleGreen"
                            Padding="10, 5"
                            HorizontalOptions="End"
                            VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="6"/>
                        </Border.StrokeShape>

                        <Label x:Name="OAStatus"
                               VerticalOptions="Center"
                               HorizontalOptions="End"
                               FontSize="16"/>
                    </Border>

                    <Label Grid.Column="0"
                           Grid.Row="1"
                           Text="Start date:"/>
                    <Label Grid.Column="1"
                           Grid.Row="1"
                           x:Name="OAStartDate"
                           HorizontalOptions="End"/>

                    <Label Grid.Column="0"
                           Grid.Row="2"
                           Text="End date:"/>
                    <Label Grid.Column="1"
                           Grid.Row="2"
                           x:Name="OAEndDate"
                           HorizontalOptions="End"/>
                </Grid>

            </Border>

            <Border Stroke="Black"
                    StrokeThickness="1"
                    BackgroundColor="LightSteelBlue"
                    Padding="15"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    WidthRequest="350"
                    IsVisible="False"
                    x:Name="PAssessmentBorder">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="6" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="*,*"
                      RowDefinitions="*,*,*"
                      RowSpacing="10">

                    <Label Grid.Column="0" 
                           Grid.Row="0"
                           x:Name="PAName"
                           VerticalOptions="Center"
                           FontSize="16"/>
                    <Border Grid.Column="1"
                            Grid.Row="0"
                            BackgroundColor="PaleGreen"
                            Padding="10, 5"
                            HorizontalOptions="End"
                            VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="6"/>
                        </Border.StrokeShape>

                        <Label x:Name="PAStatus"
                               VerticalOptions="Center"
                               HorizontalOptions="End"
                               FontSize="16"/>
                    </Border>

                    <Label Grid.Column="0" 
                           Grid.Row="1" 
                           Text="Start date:"/>
                    <Label Grid.Column="1"
                           Grid.Row="1"
                           x:Name="PAStartDate"
                           HorizontalOptions="End"/>

                    <Label Grid.Column="0"
                           Grid.Row="2"
                           Text="End date:"/>
                    <Label Grid.Column="1"
                           Grid.Row="2"
                           x:Name="PAEndDate"
                           HorizontalOptions="End"/>

                </Grid>
                
            </Border>

        </VerticalStackLayout>

    </ScrollView>
</ContentPage>