<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StudentPortalApp.Views.ChangeName"
             Title="Change Username">
    <VerticalStackLayout Padding="20">
        <Label Text="Change your username"
               VerticalOptions="Center"
               FontSize="16"/>
        <Entry Placeholder="new username"
               Text=""
               x:Name="username"/>
        <Label Text="Please enter your new username"
               x:Name="usernameLabel"
               IsVisible="False"
               TextColor="Red"/>
        <Label Text="Username is taken"
               x:Name="usernameTaken"
               IsVisible="False"
               TextColor="Red"/>
        <Button Text="Confirm"
                Clicked="ConfirmClicked"
                Margin="0,10"/>
        <Button Text="Cancel"
                Clicked="CancelClicked"
                Margin="0,5"/>
    </VerticalStackLayout>
</ContentPage>