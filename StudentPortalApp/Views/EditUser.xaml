<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StudentPortalApp.Views.EditUser"
             Title="User Settings">
    <VerticalStackLayout Padding="20">
        
        <Label Text="Settings"
               VerticalOptions="Center"
               FontSize="24"
               Margin="0,0,0,50"/>

        <Grid ColumnDefinitions=".3*,.7*"
              HorizontalOptions="Center">
            <Label Grid.Column="0"
                   Text="Username: "
                   VerticalOptions="Center"
                   FontSize="16"/>
            <Label Grid.Column="1"
                   Text=""
                   x:Name="username"
                   HorizontalOptions="Start"
                   VerticalOptions="Center"
                   FontSize="16"/>
        </Grid>

        <Grid RowDefinitions="*,*,*"
              RowSpacing="10"
              Margin="0,20,0,0"
              HorizontalOptions="Center">
            <Button Grid.Row="0"
                    Text="Change username"
                    Clicked="ChangeUsernameClicked"/>
            <Button Grid.Row="1"
                    Text="Change password"
                    Clicked="ChangePasswordClicked"/>
            <Button Grid.Row="2"
                    Text="Sign out"
                    Margin="0,30,0,0"
                    Clicked="SignOutClicked"
                    BackgroundColor="DarkRed"/>
        </Grid>

    </VerticalStackLayout>
</ContentPage>